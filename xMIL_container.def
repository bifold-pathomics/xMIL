Bootstrap: docker
From: continuumio/miniconda3

%files
    pip_requirements.txt /pip_requirements.txt
    pip_requirements.txt /opt/xmil/pip_requirements.txt
    pyproject.toml /opt/xmil/pyproject.toml
    README.md /opt/xmil/README.md
    LICENSE /opt/xmil/LICENSE
    src /opt/xmil/src

%post
    chmod 1777 /tmp # necessary in case one wants to use apt on our cluster (this can also be done outside the .def file)

    # openslide-tools for openslide-python
    apt update -y
    apt install openslide-tools -y

    conda update -n base -c defaults conda -y
    conda create -n myenv python=3.10

    # nvcc for mamba-ssm
    conda run --no-capture-output -n myenv conda install cuda -c nvidia

    # torch and torchvision with cuda
    conda run --no-capture-output -n myenv pip install --root-user-action=ignore torch==2.0.1+cu118 torchvision==0.15.2+cu118 --extra-index-url https://download.pytorch.org/whl/cu118

    # torch==2.0.1's cpp_extension imports pkg_resources, which newer setuptools
    # (>=81) no longer ships - pin to a version that still has it.
    conda run --no-capture-output -n myenv pip install --root-user-action=ignore "setuptools<81"

    # mamba-ssm and causal-conv1d import torch in their setup.py at build time,
    # so they must be built without pip's isolated build env (which lacks the
    # already-installed pinned torch) - see mamba-ssm README.
    conda run --no-capture-output -n myenv pip install --root-user-action=ignore --no-build-isolation -r /pip_requirements.txt

    # Install the xMIL package without resolving its dependencies a second time.
    conda run --no-capture-output -n myenv pip install --root-user-action=ignore --no-deps /opt/xmil
    conda clean -afy
    rm -rf /root/.cache/pip
    # Source environment at runtime
    echo ". /opt/conda/etc/profile.d/conda.sh" >> $SINGULARITY_ENVIRONMENT
    echo "conda activate myenv" >> $SINGULARITY_ENVIRONMENT
